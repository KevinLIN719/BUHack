# Copy to .env locally. Never commit API keys.
PORT=3001
DATABASE_PATH=.data/policy-lens.sqlite
# Set the key only in your local .env and restart the backend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Vercel uses its server-only OIDC identity for AI Gateway when no DeepSeek key is set.
# Optional for local Gateway testing; never expose this to the browser.
AI_GATEWAY_API_KEY=
# Optional direct Gemini authentication if Gateway billing is not enabled.
GOOGLE_GENERATIVE_AI_API_KEY=
POLICY_LENS_TEXT_MODEL=deepseek/deepseek-v3.1
POLICY_LENS_OCR_MODEL=google/gemini-2.5-flash
# Automatically installed by connecting a PRIVATE Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=
CAPTURE_SESSION_TTL_MINUTES=30
# Optional TURN relay for networks that block direct WebRTC. JSON stays server-side
# until a paired camera session requests the ICE configuration.
# CAPTURE_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turns:relay.example.com:443","username":"...","credential":"..."}]
